<?xml version="1.0"?>
<interfaceDefinition>
  <node name="execute">
    <properties>
      <help>Execute operational commands</help>
    </properties>
    <children>
      <node name="wwan">
        <properties>
          <help>Execute WWAN operations</help>
        </properties>
        <children>
          <leafNode name="stop-manager">
            <properties>
              <help>Stop the WWAN manager service</help>
            </properties>
            <command>${vyos_op_scripts_dir}/wwan.py execute_stop_manager</command>
          </leafNode>
        </children>
      </node>
    </children>
  </node>
  <node name="set">
    <children>
      <node name="wwan">
        <properties>
          <help>Set WWAN components</help>
        </properties>
        <children>
          <tagNode name="firmware">
            <properties>
              <help>Path to a ZIP archive containing the WWAN firmware binary</help>
              <completionHelp>
                <script>find . -maxdepth 1 -type f -iname '*.zip' -printf '%p\n'</script>
              </completionHelp>
            </properties>
            <command>${vyos_op_scripts_dir}/wwan.py set_firmware --archive="$4"</command>
          </tagNode>
        </children>
      </node>
    </children>
  </node>
</interfaceDefinition>
