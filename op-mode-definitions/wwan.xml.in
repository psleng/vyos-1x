<?xml version="1.0"?>
<interfaceDefinition>
  <node name="set">
    <children>
      <node name="wwan">
        <properties>
          <help>Set wwan operations</help>
        </properties>
        <children>
          <virtualTagNode>
            <properties>
              <help>Target wwan interface</help>
              <completionHelp>
                <path>interfaces wwan</path>
                <script>cd /sys/class/net; ls -d wwan* 2>/dev/null</script>
              </completionHelp>
            </properties>
            <children>
              <tagNode name="firmware">
                <properties>
                  <help>Install available wwan firmware version</help>
                  <completionHelp>
                    <script>sudo ${vyos_op_scripts_dir}/wwan_firmware.py show_firmware --interface="${COMP_WORDS[2]}" --quiet</script>
                  </completionHelp>
                </properties>
                <command>${vyos_op_scripts_dir}/wwan_firmware.py set_firmware --interface="$3" --version="$5"</command>
              </tagNode>
            </children>
          </virtualTagNode>
        </children>
      </node>
    </children>
  </node>
  <node name="show">
    <children>
      <node name="wwan">
        <properties>
          <help>Show wwan information</help>
        </properties>
        <children>
          <virtualTagNode>
            <properties>
              <help>wwan interface name</help>
              <completionHelp>
                <path>interfaces wwan</path>
                <script>cd /sys/class/net; ls -d wwan* 2>/dev/null</script>
              </completionHelp>
            </properties>
            <children>
              <leafNode name="firmware">
                <properties>
                  <help>Show compatible wwan firmware versions</help>
                </properties>
                <command>${vyos_op_scripts_dir}/wwan_firmware.py show_firmware --interface="$3"</command>
              </leafNode>
            </children>
          </virtualTagNode>
        </children>
      </node>
    </children>
  </node>
  <node name="execute">
    <properties>
      <help>Execute operational commands</help>
    </properties>
    <children>
      <node name="wwan">
        <properties>
          <help>Execute wwan operations</help>
        </properties>
        <children>
          <leafNode name="stop-manager">
            <properties>
              <help>Stop the wwan manager service</help>
            </properties>
            <command>${vyos_op_scripts_dir}/wwan_firmware.py execute_stop_manager</command>
          </leafNode>
        </children>
      </node>
    </children>
  </node>
  <node name="delete">
    <children>
      <node name="wwan">
        <properties>
          <help>Delete wwan components</help>
        </properties>
        <children>
          <virtualTagNode>
            <properties>
              <help>Target wwan interface</help>
              <completionHelp>
                <path>interfaces wwan</path>
                <script>cd /sys/class/net; ls -d wwan* 2>/dev/null</script>
              </completionHelp>
            </properties>
            <children>
              <tagNode name="firmware">
                <properties>
                  <help>Delete downloaded wwan firmware version</help>
                  <completionHelp>
                    <script>sudo ${vyos_op_scripts_dir}/wwan_firmware.py show_firmware --interface="${COMP_WORDS[2]}" --quiet --downloaded-only</script>
                  </completionHelp>
                </properties>
                <command>sudo ${vyos_op_scripts_dir}/wwan_firmware.py delete_firmware --interface="$3" --version="$5"</command>
              </tagNode>
            </children>
          </virtualTagNode>
        </children>
      </node>
    </children>
  </node>
</interfaceDefinition>
