# Don't add default route if no-default-route is configured for interface

function get_no_default_route {
    local conf="/run/dhclient/dhclient_${interface}.conf"
    if [ -f "$conf" ]; then
        # interface.py (data/templates/dhcp-client/ipv4.j2) omits "routers"
        # from the DHCP request line exactly when no-default-route is
        # configured for this interface. Use that as a cheap, boot-safe signal
        # (the conf is rendered before dhclient starts) instead of loading the
        # full running config on every DHCP event.
        grep -qw routers "$conf" || echo "True"
        return
    fi
    # Fallback (conf not yet rendered): consult the running config. As
    # configuration is not available to cli-shell-api at the first boot, we
    # must use vyos.config, which contains a workaround for this.
    python3 - <<'PYEND'
from vyos.config import Config
import os

config = Config()
if config.exists('interfaces'):
    iface_types = config.list_nodes('interfaces')
    for iface_type in iface_types:
        if config.exists("interfaces {} {} dhcp-options no-default-route".format(iface_type, os.environ['interface'])):
            print("True")
PYEND
}

if [[ "$(get_no_default_route)" == 'True' ]]; then
    new_routers=""
fi
