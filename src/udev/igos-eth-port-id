#!/usr/bin/env python3
"""Generic per-physical-port id for any ethN netdev.

Emits a line of the form:
  IGOS_ETH_PORT=<parent-devpath>#<port-number>
on stdout when a stable physical-socket identifier can be derived,
and exits 0.  On any failure prints nothing and exits non-zero.

Input:
  sys.argv[1] : udev devpath (use "%p" in the rule's IMPORT{program}=).
"""

import os
import re
import sys


def _port_from_attr(ifname, attr):
    """Trailing integer of /sys/class/net/<ifname>/<attr>
    (e.g. phys_port_name 'p2' -> 2, dev_port '0' -> 0)."""
    try:
        val = open(f"/sys/class/net/{ifname}/{attr}").read().strip()
    except OSError:
        return None
    m = re.search(r"(\d+)$", val)
    return int(m.group(1)) if m else None


def _read_port_id_sources():
    """Attribute name(s) whose trailing integer locates a port, declared by the
    pin map's ETH_PORT_ID_SOURCE and written to /usr/lib/igos/eth-port-id.source
    at image-build time. Tried in order. Empty when the pin map declares none:
    this helper carries no hardware assumptions of its own -- every board / SoC /
    switch fact lives on the build side."""
    try:
        data = open("/usr/lib/igos/eth-port-id.source").read()
    except OSError:
        return []
    return [s.strip() for s in data.replace(",", "\n").splitlines() if s.strip()]


def _write_rescan_hint(ifname, name):
    """Metadata drop so vyos-interface-rescan notices this interface. Content is
    the MAC, used only as a hint -- never for naming."""
    try:
        mac = open(f"/sys/class/net/{ifname}/address").read().strip()
    except OSError:
        mac = ""
    try:
        os.makedirs("/run/udev/vyos", exist_ok=True)
        with open(os.path.join("/run/udev/vyos", name), "w") as hf:
            hf.write(mac)
    except OSError:
        pass


def main():
    devpath = sys.argv[1] if len(sys.argv) > 1 else ""

    if "/net/" not in devpath:
        return 1

    parts = devpath.rsplit("/net/", 1)
    if len(parts) != 2:
        return 1
    parent, ifname = parts
    if not parent or not ifname:
        return 1

    # path -> name, generated from the pin map's ETH_INTERFACES at build time.
    interfaces = {}
    try:
        with open("/usr/lib/igos/interfaces.conf") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                path, sep, name = line.partition("=")
                if sep:
                    interfaces[path.strip()] = name.strip()
    except OSError:
        return 1

    # The pin map declares which sysfs attribute(s) locate a port
    # (ETH_PORT_ID_SOURCE); try them in order and assign on the first whose
    # <parent-devpath>#<port> is pinned above. All board / SoC / external-switch
    # specifics stay on the build side; this helper keeps no hardware
    # assumptions and never looks at MAC addresses.
    for source in _read_port_id_sources():
        port = _port_from_attr(ifname, source)
        if port is None:
            continue
        key = f"{parent}#{port}"
        name = interfaces.get(key)
        if name is None:
            continue
        print(f"IGOS_ETH_PORT={key}")
        print(f"IGOS_IFNAME={name}")
        _write_rescan_hint(ifname, name)
        return 0

    return 0


if __name__ == "__main__":
    sys.exit(main())
