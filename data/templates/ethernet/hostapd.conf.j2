### Autogenerated by interfaces_ethernet.py ###
#
# hostapd IEEE 802.1X authenticator (wired) configuration.  Rendered when
# 'interfaces ethernet <n> authentication' is configured.  When the
# 'authentication macsec' subtree is present the MACsec (MKA key server)
# driver is selected, otherwise plain wired 802.1X is used.
#
{% set auth = authentication %}
interface={{ ifname }}
{% if auth.macsec is vyos_defined %}
driver=macsec_linux
# IEEE Std 802.1X-2010 requires EAPOL version 3 when MACsec is in use.
eapol_version=3
{% else %}
driver=wired
eapol_version=2
{% endif %}
ieee8021x=1
# Wired authenticator uses the PAE group multicast address for EAPOL.
use_pae_group_addr=1
# Control socket for hostapd_cli / runtime status.
ctrl_interface=/run/hostapd

{% if auth.radius.server is vyos_defined %}
# EAP relayed to external RADIUS server(s); first entry is primary.
{%     for server, server_config in auth.radius.server.items() if server_config.disable is not vyos_defined %}
auth_server_addr={{ server }}
auth_server_port={{ server_config.port if server_config.port is vyos_defined else '1812' }}
auth_server_shared_secret={{ server_config.key }}
{%     endfor %}
{% elif auth.eap_server is vyos_defined %}
# Local EAP-TLS authentication server (no external RADIUS).
eap_server=1
eap_user_file=/run/hostapd/{{ ifname }}.eap_user
{%     if auth.eap_server.ca_file is vyos_defined %}
ca_cert={{ auth.eap_server.ca_file }}
{%     endif %}
server_cert={{ auth.eap_server.cert_file }}
private_key={{ auth.eap_server.key_file }}
{% endif %}

{% if auth.macsec is vyos_defined %}
# MACsec Key Agreement (MKA) - authenticator acts as key server.
macsec_policy=1
# 0 = encrypt (confidentiality), 1 = integrity only.
macsec_integ_only={{ '0' if auth.macsec.encrypt is vyos_defined else '1' }}
# 0 = GCM-AES-128, 1 = GCM-AES-256.
macsec_csindex={{ '1' if auth.macsec.cipher is vyos_defined('gcm-aes-256') else '0' }}
{%     if auth.macsec.mka.priority is vyos_defined %}
mka_priority={{ auth.macsec.mka.priority }}
{%     endif %}
{%     if auth.macsec.mka.cak is vyos_defined and auth.macsec.mka.ckn is vyos_defined %}
# Pre-shared CAK - PSK key-server mode (no EAP required for keying).
mka_cak={{ auth.macsec.mka.cak }}
mka_ckn={{ auth.macsec.mka.ckn }}
{%     endif %}
{% endif %}
