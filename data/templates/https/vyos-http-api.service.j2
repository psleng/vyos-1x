{% set vrf_command = 'ip vrf exec ' ~ vrf ~ ' ' if vrf is vyos_defined else '' %}
[Unit]
Description=VyOS HTTP API service
After=vyos-router.service
Requires=vyos-router.service
ConditionPathExists={{ api_config_state }}

[Service]
ExecStart={{ vrf_command }}/usr/libexec/vyos/services/vyos-http-api-server
ExecReload=kill -HUP $MAINPID
Type=idle

SyslogIdentifier=vyos-http-api
SyslogFacility=daemon

# Use 'always' rather than 'on-failure': a reload (SIGHUP) that races the
# server's startup can make it exit cleanly, which 'on-failure' would not
# recover, leaving the API (and the GUI config service) dead until the next
# manual restart. An explicit 'systemctl stop' is not subject to Restart=.
Restart=always
RestartSec=1

# Does't work but leave it here
User=root
Group=vyattacfg

[Install]
WantedBy=vyos.target
