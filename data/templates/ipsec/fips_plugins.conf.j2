### Autogenerated by vpn_ipsec.py (FIPS 140-3) ###
#
# Force charon's IKE crypto through the validated OpenSSL provider: disable the
# native strongSwan crypto plugins and the kernel af-alg plugin so only the
# openssl plugin provides cryptographic primitives. The openssl plugin uses the
# providers configured in the system openssl.cnf (the FIPS + base providers,
# with default_properties = fips=yes), and load_legacy=no keeps it from pulling
# in the legacy provider's non-approved algorithms.
#
# This file is included inside charon.plugins {} via strongswan.conf and sorts
# last in strongswan.d/charon, so these settings override the shipped per-plugin
# load=yes (the last definition wins). ESP bulk (data-plane) crypto stays in the
# kernel; only IKE moves into the validated module (see igos-fips-140-3-design.md
# section 6.2).

aes { load = no }
rc2 { load = no }
des { load = no }
blowfish { load = no }
sha1 { load = no }
sha2 { load = no }
md4 { load = no }
md5 { load = no }
gmp { load = no }
curve25519 { load = no }
chapoly { load = no }
xcbc { load = no }
cmac { load = no }
hmac { load = no }
ctr { load = no }
ccm { load = no }
gcm { load = no }
gcrypt { load = no }
drbg { load = no }
random { load = no }
fips-prf { load = no }
af-alg { load = no }

openssl {
    load = yes
    load_legacy = no
}
