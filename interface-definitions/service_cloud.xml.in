<?xml version="1.0"?>
<interfaceDefinition>
  <node name="service">
    <children>
      <node name="cloud" owner="${vyos_conf_scripts_dir}/service_cloud.py">
        <properties>
          <help>Cloud service settings</help>
          <priority>1280</priority>
        </properties>
        <children>
          <leafNode name="enabled">
            <properties>
              <help>Enable cloud service</help>
              <valueless/>
            </properties>
          </leafNode>
          <leafNode name="override-device-url">
            <properties>
              <help>Override the default PerleCloud device URL</help>
              <valueHelp>
                <format>txt</format>
                <description>Custom URL for PerleCloud device endpoint</description>
              </valueHelp>
            </properties>
          </leafNode>
        </children>
      </node>
    </children>
  </node>
</interfaceDefinition>
