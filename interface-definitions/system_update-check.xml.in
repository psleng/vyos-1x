<?xml version="1.0" encoding="UTF-8"?>
<interfaceDefinition>
  <node name="system">
    <children>
      <node name="update-check" owner="${vyos_conf_scripts_dir}/system_update-check.py">
        <properties>
          <help>Check available update images</help>
          <priority>9999</priority>
        </properties>
        <children>
          <leafNode name="auto-check">
            <properties>
              <help>Enable auto check for new images</help>
              <valueless/>
            </properties>
          </leafNode>
          <leafNode name="disable">
            <properties>
              <help>Disable automatic image update checks (enabled by default)</help>
              <valueless/>
            </properties>
          </leafNode>
          <node name="cellular-firmware">
            <properties>
              <help>Cellular modem firmware update settings</help>
            </properties>
            <children>
              #include <include/url-http-https.xml.i>
              <leafNode name="auto-check">
                <properties><help>Check cellular firmware every 12 hours (notify only)</help><valueless/></properties>
              </leafNode>
              <leafNode name="disable">
                <properties><help>Disable cellular firmware checks</help><valueless/></properties>
              </leafNode>
              <leafNode name="wall">
                <properties><help>Broadcast changed cellular update notices to logged-in users</help><valueless/></properties>
              </leafNode>
              <node name="cache">
                <properties>
                  <help>Retain verified firmware archives for reuse</help>
                </properties>
                <children>
                  <leafNode name="enable">
                    <properties>
                      <help>Enable archive retention (disabled by default)</help>
                      <valueless/>
                    </properties>
                  </leafNode>
                  <leafNode name="max-archives">
                    <properties>
                      <help>Maximum number of cached archives</help>
                      <valueHelp>
                        <format>u32:1-100</format>
                        <description>Archive count (default: 2)</description>
                      </valueHelp>
                      <constraint>
                        <validator name="numeric" argument="--range 1-100"/>
                      </constraint>
                    </properties>
                    <defaultValue>2</defaultValue>
                  </leafNode>
                  <leafNode name="max-size">
                    <properties>
                      <help>Maximum total cache size in MiB</help>
                      <valueHelp>
                        <format>u32:1-409600</format>
                        <description>Size in MiB (default: 512)</description>
                      </valueHelp>
                      <constraint>
                        <validator name="numeric" argument="--range 1-409600"/>
                      </constraint>
                    </properties>
                    <defaultValue>512</defaultValue>
                  </leafNode>
                </children>
              </node>
            </children>
          </node>
          #include <include/url-http-https.xml.i>
        </children>
      </node>
    </children>
  </node>
</interfaceDefinition>
